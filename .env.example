# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwXyZ

# ID администраторов через запятую, у которых будет доступ к /admin
ADMIN_IDS=123456789,987654321

# Параметры подключения к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=vpn_user
DB_PASSWORD=my_secure_postgres_password
DB_NAME=multi_vpn_db

# Валюта для отображения в меню оплаты (например, USDT, TON, RUB)
PAYMENT_CURRENCY=USDT

# Стоимость тарифа BASE
PRICE_BASE_1_MONTH=5.0
PRICE_BASE_3_MONTHS=13.5
PRICE_BASE_6_MONTHS=25.0

# Стоимость тарифа PREMIUM
PRICE_PREMIUM_1_MONTH=8.0
PRICE_PREMIUM_3_MONTHS=21.6
PRICE_PREMIUM_6_MONTHS=38.4

# Название вашего бренда для White Label инвойсов в CryptoBot
BRAND_NAME=Overlord Multi-VPN

# Токен платежной системы Crypto Pay от @CryptoBot / @CryptoTestnetBot
CRYPTO_BOT_TOKEN=123456:AAFlk...

# Режим сети: True — реальные деньги (@CryptoBot), False — тестовая сеть (@CryptoTestnetBot)
CRYPTO_BOT_NET=False
